# Dependencies
node_modules/
.pnp
.pnp.js

# Env files (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Next.js
.next/
frontend/.next/
frontend/out/
frontend/build/

# Stray root-level installs (dependencies belong in frontend/ or backend/,
# never at the repo root — these appear if a command is accidentally run
# from the repo root instead of a subproject directory)
/node_modules/
/package.json
/package-lock.json

# Local harness/session state (not part of the project)
.claude/

# Backend
backend/dist/
backend/build/

# Postgres data (Docker volume mounts if any land in-repo)
pgdata/
*.sqlite

# Evidence storage volume (never commit user-uploaded evidence). AUDIT
# FIX (re-audit, 2026-09-14): the old bare `storage/` pattern below (no
# leading slash) matched ANY directory named "storage" anywhere in the
# tree, not just this one — it was silently also ignoring
# backend/src/storage/, a real source directory (files.ts), which meant
# that file was never committed at all. Removed the overly-broad
# duplicate; this specific path already covers the real target.
backend/storage/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Test/coverage
coverage/
.nyc_output/

# GenLayer local artifacts
contracts/__pycache__/
contracts/*.pyc

# Python
__pycache__/
*.pyc
.venv/
venv/
